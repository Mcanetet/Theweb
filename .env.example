# Servidor
PORT=3001
NODE_ENV=development

# Base de datos SQLite (ruta relativa al proyecto)
DATABASE_PATH=./data/theweb.db

# Seguridad — cambiar en producción
SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
SESSION_DAYS=7

# CORS — URLs del sitio (separadas por coma)
CORS_ORIGIN=http://localhost:5500,http://localhost:3001,https://theweb.cl,https://www.theweb.cl

# Email — buzón de destino
CONTACT_EMAIL=contacto@theweb.cl

# SMTP Hostinger (obligatorio para que Node envíe de verdad).
# Crea el correo contacto@theweb.cl en hPanel y pon aquí su contraseña.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@theweb.cl
SMTP_PASS=
SMTP_FROM=TheWeb. <contacto@theweb.cl>

# Acceso al Estudio (admin). URL: /estudio
ADMIN_GATE=estudio-theweb

# Theo (opcional — si no hay clave, Theo responde con conocimiento local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=cambiar-token-verificacion-webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
